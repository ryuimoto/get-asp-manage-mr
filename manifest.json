{
  "manifest_version": 3,
  "name": "Rentracks 広告案件 一覧取得",
  "version": "0.1.0",
  "description": "manage.rentracks.jp の検索結果を全ページ巡回して CSV ダウンロード",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": ["https://manage.rentracks.jp/*"],
  "action": {
    "default_title": "Rentracks 案件一覧を CSV でダウンロード",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
